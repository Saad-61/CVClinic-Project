# Hugging Face access token to avoid anonymous rate limits.
# Create backend/.env from this file and put your real token.
HF_TOKEN=your_hf_token_here

# Gemini API key used by backend/ai/llm.py
GEMINI_API_KEY=your_gemini_api_key_here

# Optional explicit Gemini model override.
# Recommended stable values:
# - gemini-2.5-flash
# - gemini-2.5-pro
# - gemini-2.0-flash
GEMINI_MODEL=

# Jooble API — get your free key at https://jooble.org/api/about
# Leave blank to skip Jooble and fall back to Remotive + Jobicy only.
JOOBLE_API_KEY=your_jooble_api_key_here

# Location to pass to Jooble (default: Pakistan)
JOB_SEARCH_LOCATION=Pakistan

# Comma-separated keywords for Jooble search queries
JOB_SEARCH_KEYWORDS=software developer,frontend developer,backend developer,python developer,react developer,data analyst


# Server ports — keep BACKEND_PORT in sync with frontend/.env VITE_BACKEND_PORT
BACKEND_PORT=
FRONTEND_PORT=